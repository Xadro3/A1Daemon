[Unit]
Description=A1Daemon 0.5 hardware service
Documentation=https://github.com/Xadro3/aidaemon
After=systemd-udev-trigger.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/a1daemon service --enable-writes --preferences-file /var/lib/a1daemon/preferences.json
RuntimeDirectory=a1daemon
RuntimeDirectoryMode=0750
StateDirectory=a1daemon
StateDirectoryMode=0700
UMask=0027
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
